<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/theme_section_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDarkMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dark_theme"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/color_presets_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <android.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="4">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnColorDefault"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/preset_white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnColorGreen"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/preset_green"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnColorYellow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/preset_yellow"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnColorRed"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/preset_red"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp" />
    </android.widget.GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="32dp"
        android:text="@string/close" />

</LinearLayout>
